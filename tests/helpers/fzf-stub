#!/usr/bin/env bash
set -euo pipefail
for arg; do
  case "$arg" in --select-1 | --filter=*) exit 0 ;; esac
done
if [[ -n ${FZD_STUB_FZF_LOG:-} ]]; then printf '%s\n' "$@" >>"$FZD_STUB_FZF_LOG"; fi
if [[ -n ${FZD_STUB_PLAN:-} ]]; then
  IFS=$'\t' read -r FZD_STUB_ACTION encoded <"$FZD_STUB_PLAN" || exit 130
  tail -n +2 "$FZD_STUB_PLAN" >"$FZD_STUB_PLAN.next"
  cat "$FZD_STUB_PLAN.next" >"$FZD_STUB_PLAN"
  FZD_STUB_SELECTION=$(
    printf '%s' "$encoded" | base64 -d
    printf '.'
  )
  FZD_STUB_SELECTION=${FZD_STUB_SELECTION%.}
  if [[ "$FZD_STUB_ACTION" == ctrl-f ]]; then
    printf '\nctrl-f\n'
    exit 0
  fi
fi
[[ -n ${FZD_STUB_ACTION:-} ]] || exit 130
for arg; do
  if [[ "$arg" == *"echo A:${FZD_STUB_ACTION}:"* ]]; then
    control=${arg##* > }
    control=${control%)+abort}
    control=${control%)+print-query}
    # Later command strings quote fixed paths; the fixture path contains no quotes.
    control=${control#\'}
    control=${control%\'}
    control=${control#\"}
    control=${control%\"}
    encoded=$(printf '%s' "${FZD_STUB_SELECTION:-}" | base64 | tr -d '\n')
    printf 'A:%s:%s\n' "$FZD_STUB_ACTION" "$encoded" >"$control"
    exit 130
  fi
done
exit 2
