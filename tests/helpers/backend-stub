#!/usr/bin/env bash
set -euo pipefail
printf '%s\0' "$@" >"$FZD_STUB_LOG"
case ${0##*/} in
  plocate | locate) rc=${FZD_STUB_LOCATE_STATUS:-0} ;;
  *) rc=${FZD_STUB_FD_STATUS:-0} ;;
esac
((rc == 0)) || exit "$rc"
null=0
for arg; do
  [[ "$arg" == -0 || "$arg" == --print0 || "$arg" == --null ]] && null=1
done
if ((null)); then
  cat "$FZD_STUB_RESULTS"
else
  tr '\000' '\n' <"$FZD_STUB_RESULTS"
fi
