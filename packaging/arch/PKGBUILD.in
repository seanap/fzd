# Generated from an immutable FZD commit. Build with makepkg, never as root.
# Source commit: @COMMIT@
# Reproducible builds: SOURCE_DATE_EPOCH=@EPOCH@ makepkg
# Before publication, place the matching source archive beside this PKGBUILD.
pkgname=fzd
pkgver=@ARCH_VERSION@
pkgrel=1
pkgdesc='Fast keyboard-driven terminal file explorer built with Bash and fzf'
arch=('any')
url='https://github.com/seanap/fzd'
license=('MIT')
depends=('plocate' 'bash>=4.4' 'fzf>=0.44.0' 'zoxide>=0.9.0' 'coreutils>=8.28' 'findutils' 'util-linux' 'grep' 'sed' 'gawk' 'micro')
optdepends=('eza: recommended icon and color directory previews' 'fd: fast filesystem search' 'bat: colorized file previews'
  'file: file type detection' 'tree: directory previews'
  'glib2: recoverable Trash through gio' 'trash-cli: alternative Trash provider'
  'chafa: image previews' 'glow: Markdown previews' 'wl-clipboard: Wayland clipboard' 'xclip: X11 clipboard')
optdepends+=('zsh: alternative interactive shell'
  'zsh-autosuggestions: opt-in inline suggestions in zsh')
source=('https://github.com/seanap/fzd/releases/download/v@VERSION@/fzd-@VERSION@.tar.gz')
sha256sums=('@SHA256@')

package() {
  cd "$srcdir/fzd-@VERSION@"
  bash install.sh --stage "$pkgdir" --prefix /usr
  install -Dm644 README.md "$pkgdir/usr/share/doc/fzd/README.md"
  install -Dm644 docs/packaging.md "$pkgdir/usr/share/doc/fzd/packaging.md"
  install -Dm644 docs/TECHNICAL.md "$pkgdir/usr/share/doc/fzd/TECHNICAL.md"
  install -Dm644 packaging/fzd.1 "$pkgdir/usr/share/man/man1/fzd.1"
}
