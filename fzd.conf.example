# ~/.config/fzd/fzd.conf

# --- Global search tuning ---
FZD_GLOBAL_BACKEND=auto            # auto|locate|cache|live
FZD_GLOBAL_MINLEN=2
FZD_GLOBAL_MAXDEPTH=6
FZD_GLOBAL_MAXRESULTS=5000
FZD_GLOBAL_PATHS="/etc /opt /srv /home/$USER"
# For roots containing spaces or newlines, use a Bash array instead:
# FZD_GLOBAL_ROOTS=("/path with spaces" "$HOME")
FZD_GLOBAL_XEXCLUDES="mnt,proc,sys,dev,run,proc/*,sys/*,dev/*,run/*,snap,lost+found,var/lib/docker"

# Optional locate DB(s); leave unset to use the backend default.
# FZD_LOCATE_DBS="/var/lib/plocate/plocate.db"

# Excludes for dir trees and fd/find fallbacks
FZD_EXCLUDES=".git,node_modules,.cache,.venv,.tox,dist,build,__pycache__,.DS_Store"

# Preview
FZD_ICONS=1                       # 0 disables eza icons for fonts without Nerd glyphs
FZD_PREVIEW_DEPTH=2
FZD_PREVIEW_TIMEOUT=2
# Glow uses auto styling for captured previews. Override with dark, light or a JSON file:
# FZD_GLOW_STYLE=dark
FZD_PREVIEW_MAX_LINES=200

# Optional label colors (hex). Leave commented to inherit your fzf/system theme.
# FZD_COLOR_DIR="#f9e2af"
# FZD_COLOR_FILE="#cdd6f4"


# Automatic Omarchy session palette: auto (default) or 0 to opt out.
# FZD_OMARCHY_THEME=auto
# Optional explicit fzf role overrides: FZD_COLOR_BORDER / HIGHLIGHT / FG / BG.
